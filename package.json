{
  "name": "zomboid-build",
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@org/linter": "workspace:*",
    "turbo": "2.6.1",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "docker:down": "turbo run docker:down",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:write": "biome check --write ."
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
