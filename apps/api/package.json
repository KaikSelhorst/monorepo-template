{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=api",
    "build:alpine": "bun run build --minify --sourcemap --target=bun-linux-x64-musl",
    "preview": "./api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:kill": "docker compose down --volumes --remove-orphans"
  },
  "dependencies": {
    "@org/database": "workspace:*",
    "@org/validation": "workspace:*",
    "elysia": "latest"
  },
  "devDependencies": {
    "@org/tsconfig": "workspace:*",
    "@types/bun": "1.3.2",
    "bun-types": "latest"
  }
}
