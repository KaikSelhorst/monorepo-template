{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=api",
    "build:alpine": "bun run build --minify --sourcemap --target=bun-linux-x64-musl",
    "preview": "./api",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@org/auth": "workspace:*",
    "@org/cache": "workspace:*",
    "@org/database": "workspace:*",
    "@org/validation": "workspace:*",
    "elysia": "1.4.28"
  },
  "devDependencies": {
    "@org/tsconfig": "workspace:*",
    "@types/bun": "1.3.13",
    "bun-types": "1.3.13"
  }
}
